{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bull-board": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "mongoose": "^8.20.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.10",
    "redis": "^5.10.0",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "scripts": {
    "test": "mocha tests --recursive --timeout 20000",
    "test:unit": "mocha tests/unit --recursive --timeout 20000",
    "test:e2e": "mocha tests/e2e --recursive --timeout 30000",
    "test:watch": "mocha tests --recursive --watch --timeout 20000",
    "coverage": "nyc npm test",
    "coverage:unit": "nyc npm run test:unit",
    "coverage:e2e": "nyc npm run test:e2e"
  },
  "devDependencies": {
    "chai": "^6.2.1",
    "mocha": "^11.7.5",
    "mongodb-memory-server": "^10.3.0",
    "nyc": "^17.1.0",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4"
  },
  "nyc": {
    "check-coverage": true,
    "lines": 90,
    "functions": 90,
    "branches": 90,
    "statements": 90,
    "exclude": [
      "tests/**",
      "coverage/**",
      "*.config.js",
      "server.js"
    ]
  }
}
